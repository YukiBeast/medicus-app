# Methode für Single Choice
extract.single_choice <- function(item, data) {
all_answers <- unique(data[[get(item$name)]])
# Holt die ID und die spezifische Spalte
res <- data[, .(id = CASE, answer = factor(get(item$name),
levels = all_answers,
ordered = FALSE))]
return(res)
}
